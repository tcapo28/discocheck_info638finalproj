<body>
  <h1>{{artist.name}}</h1>

{{#if artist.albums}}
<p>
{{#each artist.albums}}
<div>
{{#if ../user}}
  <form action="/albums_users/upsert" role="form" method="post">
    <input type="hidden" name="_csrf" value="{{../_csrfToken}}">
    <input type="hidden" name="album_id" value="{{this.id}}">
    <input type="hidden" name="user_id" value="{{../user.id}}">
    <input type="hidden" name="artist_id" value="{{../artistId}}">
    <input type="checkbox" name="listened" value="true" {{#if this.listened}}checked{{/if}} onchange="this.form.submit()">
  {{/if}}
</form>
</div>
<img src={{this.albumArt}} width="150" height="150">
{{this.title}}<br>
{{this.releaseDate}}<br>
{{this.type}}<br>
<a href={{this.aStreamLink}}><img src="https://upload.wikimedia.org/wikipedia/commons/thumb/5/59/Apple_Music_Icon.svg/1280px-Apple_Music_Icon.svg.png" style="width:20px;height:20px;"></a>
<a href={{this.sStreamLink}}><img src="https://upload.wikimedia.org/wikipedia/commons/thumb/8/84/Spotify_icon.svg/1280px-Spotify_icon.svg.png" style="width:20px;height:20px;"></a>
{{/each}}
</p>
{{/if}}
<br>
  <li>
    <a href="/albums/form">MISSING OR NEW RELEASE?</a>
  </li>
<br>
  <li>
    <a href="/artists">HOME</a>
  </li>
<br>

<br>
</body>